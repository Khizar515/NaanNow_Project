<% layout('layouts/main') %>

<div class="container" style="max-width: 700px;">
    <div class="page-header">
        <div>
            <h1>Checkout</h1>
            <p>Review your order and complete payment</p>
        </div>
    </div>

    <div class="card mb-lg">
        <div class="card-header">
            <h3 class="card-title">Order Summary</h3>
            <span class="text-muted" style="font-size:var(--font-size-sm);">
                from <strong><%= cart.restaurantId ? cart.restaurantId.name : 'Restaurant' %></strong>
            </span>
        </div>

        <% cart.items.forEach(item => { %>
            <div class="d-flex justify-between align-center" style="padding:var(--space-sm) 0;font-size:var(--font-size-sm);">
                <span><%= item.quantity %>x <%= item.menuItemId.name %></span>
                <span>Rs. <%= item.menuItemId.basePrice * item.quantity %></span>
            </div>
        <% }) %>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Payment & Delivery</h3>
        </div>

        <form action="/orders/checkout" method="POST">
            <div class="form-group">
                <label for="cardId" class="form-label">Select Payment Card</label>
                <select id="cardId" name="cardId" class="form-select" required>
                    <% cards.forEach(card => { %>
                        <option value="<%= card.id %>"><%= card.cardNumberMasked %> (Rs. <%= card.balance %>)</option>
                    <% }) %>
                </select>
            </div>

            <div class="form-group">
                <label for="pin" class="form-label">Security PIN</label>
                <input type="password" id="pin" name="pin" class="form-control" required maxlength="6">
            </div>

            <div class="form-group">
                <label for="deliveryAddress" class="form-label">Delivery Address</label>
                <input type="text" id="deliveryAddress" name="deliveryAddress" class="form-control" 
                    value="<%= typeof currentUser !== 'undefined' && currentUser.address ? currentUser.address : '' %>" 
                    required>
            </div>

            <div class="form-group">
                <label class="form-label">Delivery Location</label>
                <div id="checkout-map" style="height: 300px; width: 100%; border-radius: var(--radius-sm); z-index: 1;"></div>
                <span class="form-text mb-lg">Click or drag the marker to set your exact delivery location.</span>
                <input type="hidden" id="longitude" name="longitude" required>
                <input type="hidden" id="latitude" name="latitude" required>
            </div>

            <button type="button" id="previewOrderBtn" class="btn btn-primary btn-block btn-lg">
                <i class="fas fa-file-invoice-dollar"></i> Review Final Prices
            </button>
        </form>
    </div>
</div>

<!-- Preview Modal -->
<div id="previewModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:1000; align-items:center; justify-content:center;">
    <div style="background:var(--color-bg); padding:var(--space-xl); border-radius:var(--radius-lg); max-width:500px; width:90%; box-shadow:0 10px 30px rgba(0,0,0,0.3);">
        <h2 style="margin-top:0;">Final Order Confirmation</h2>
        <p class="text-muted">Please review the final costs before placing your order.</p>
        
        <div style="background:var(--color-bg-elevated); padding:var(--space-md); border-radius:var(--radius-md); margin:var(--space-md) 0;">
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                <span>Base Item Total:</span>
                <span id="previewBaseTotal" style="font-weight:600;">Rs. 0</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                <span>Platform Markup:</span>
                <span id="previewMarkup" style="font-weight:600;">Rs. 0</span>
            </div>
            <div style="display:flex; justify-content:space-between; margin-bottom:8px;">
                <span>Delivery Fee (<span id="previewDistance">0</span> km):</span>
                <span id="previewDelivery" style="font-weight:600;">Rs. 0</span>
            </div>
            <hr style="margin:var(--space-md) 0; border-top:1px solid var(--color-border);">
            <div style="display:flex; justify-content:space-between; font-size:1.2rem; font-weight:800;">
                <span>Grand Total:</span>
                <span id="previewGrandTotal" style="color:var(--color-primary);">Rs. 0</span>
            </div>
        </div>

        <div class="d-flex gap-md mt-lg">
            <button type="button" id="cancelPreviewBtn" class="btn btn-secondary" style="flex:1;">Cancel</button>
            <button type="button" id="confirmPlaceOrderBtn" class="btn btn-primary" style="flex:1;">
                <i class="fas fa-lock"></i> Place Order & Pay
            </button>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        // Default to Lahore, Pakistan if geolocation fails
        let defaultLat = 31.5204;
        let defaultLng = 74.3587;

        const map = L.map('checkout-map').setView([defaultLat, defaultLng], 13);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(map);

        let marker = L.marker([defaultLat, defaultLng], { draggable: true }).addTo(map);
        
        function updateInputs(lat, lng) {
            document.getElementById('latitude').value = lat;
            document.getElementById('longitude').value = lng;
        }
        
        // Initial set
        updateInputs(defaultLat, defaultLng);

        // Update on drag
        marker.on('dragend', function (e) {
            const pos = marker.getLatLng();
            updateInputs(pos.lat, pos.lng);
        });

        // Update on click
        map.on('click', function(e) {
            marker.setLatLng(e.latlng);
            updateInputs(e.latlng.lat, e.latlng.lng);
        });

        // Try to get user's actual location
        if (navigator.geolocation) {
            navigator.geolocation.getCurrentPosition(function(position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                map.setView([lat, lng], 15);
                marker.setLatLng([lat, lng]);
                updateInputs(lat, lng);
            });
        }

        // Preview Logic
        const previewOrderBtn = document.getElementById('previewOrderBtn');
        const previewModal = document.getElementById('previewModal');
        const cancelPreviewBtn = document.getElementById('cancelPreviewBtn');
        const confirmPlaceOrderBtn = document.getElementById('confirmPlaceOrderBtn');
        const checkoutForm = document.querySelector('form[action="/orders/checkout"]');

        previewOrderBtn.addEventListener('click', async function() {
            // Basic validation
            if (!document.getElementById('cardId').value || !document.getElementById('pin').value || !document.getElementById('deliveryAddress').value) {
                alert("Please fill in all required fields (Card, PIN, and Address) before reviewing.");
                return;
            }

            const lat = document.getElementById('latitude').value;
            const lng = document.getElementById('longitude').value;

            // Fetch calculation
            previewOrderBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Calculating...';
            previewOrderBtn.disabled = true;

            try {
                const response = await fetch('/orders/calculate-preview', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ latitude: lat, longitude: lng })
                });
                const data = await response.json();

                if (data.error) {
                    alert(data.error);
                    return;
                }

                // Populate modal
                document.getElementById('previewBaseTotal').innerText = `Rs. ${data.baseItemTotal}`;
                document.getElementById('previewMarkup').innerText = `Rs. ${data.markupTotal}`;
                document.getElementById('previewDistance').innerText = data.distanceKm;
                document.getElementById('previewDelivery').innerText = `Rs. ${data.deliveryFee}`;
                document.getElementById('previewGrandTotal').innerText = `Rs. ${data.grandTotal}`;

                // Show modal
                previewModal.style.display = 'flex';
            } catch (err) {
                console.error(err);
                alert("Failed to calculate totals. Please try again.");
            } finally {
                previewOrderBtn.innerHTML = '<i class="fas fa-file-invoice-dollar"></i> Review Final Prices';
                previewOrderBtn.disabled = false;
            }
        });

        cancelPreviewBtn.addEventListener('click', function() {
            previewModal.style.display = 'none';
        });

        confirmPlaceOrderBtn.addEventListener('click', function() {
            confirmPlaceOrderBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';
            confirmPlaceOrderBtn.disabled = true;
            checkoutForm.submit();
        });

    });
</script>
