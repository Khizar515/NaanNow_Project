<% layout('layouts/main') %>

<div class="container">
    <div class="page-header">
        <div>
            <h1>My Profile</h1>
            <p>Manage your account details</p>
        </div>
    </div>

    <div class="grid grid-2">
        <!-- Profile Info -->
        <div class="card">
            <div style="text-align:center;margin-bottom:var(--space-xl);">
                <img src="<%= user.profilePic || '/uploads/defaults/profile-avatar.png' %>" alt="Profile" 
                    style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:3px solid var(--color-primary);margin:0 auto var(--space-md);">
                <h3><%= user.name %></h3>
                <span class="badge badge-primary"><%= user.role.replace('_', ' ') %></span>
            </div>

            <form action="/users/profile/update" method="POST">
                <div class="form-group">
                    <label class="form-label">Email (Cannot be changed)</label>
                    <input type="email" class="form-control" value="<%= user.email %>" disabled>
                </div>
                <div class="form-group">
                    <label class="form-label">Name</label>
                    <input type="text" name="name" class="form-control" value="<%= user.name %>" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Phone</label>
                    <input type="text" name="phone" class="form-control" value="<%= user.phone %>" required>
                </div>
                <div class="form-group">
                    <label class="form-label">Address</label>
                    <input type="text" name="address" class="form-control" value="<%= user.address || '' %>">
                </div>
                
                <hr style="margin: var(--space-lg) 0; border: 0; border-top: 1px solid var(--color-border);">
                
                <h4 style="margin-bottom: var(--space-md);">Change Password (Optional)</h4>
                <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input type="password" name="password" class="form-control" placeholder="Leave blank to keep current password">
                </div>
                
                <div class="form-group" style="margin-bottom: var(--space-md);">
                    <span class="text-muted" style="font-size: var(--font-size-sm);">
                        Member Since: <%= new Date(user.createdAt).toLocaleDateString('en-PK', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                    </span>
                </div>

                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </form>
        </div>

        <!-- Update Profile Picture -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Update Profile Picture</h3>
            </div>
            <form action="/users/profile-pic" method="POST" enctype="multipart/form-data">
                <div class="form-group">
                    <label class="form-label">Choose a new photo</label>
                    <input type="file" name="image" class="form-file-input form-control" accept="image/*" required>
                </div>
                <button type="submit" class="btn btn-primary btn-block">
                    <i class="fas fa-camera"></i> Upload Photo
                </button>
            </form>
        </div>
    </div>
</div>
